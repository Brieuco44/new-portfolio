    "dev": "hugo server -D",
    "build": "hugo --gc --minify"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.23",
    "postcss-cli": "^11.0.1",
    "tailwindcss": "^4.3.3"
  }
}
